# Rewind 环境变量模板
# 用法：cp .env.example backend/.env（或复制到 backend/ 下改名 .env）然后填入你的配置

# ---- LLM（OpenAI-compatible，三选一示例）----
# OpenAI:  https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 智谱 GLM: https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama: http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ---- 本地体验（无 Key 时启用 Mock 引擎：真实执行工具、启发式报告）----
# REWIND_MOCK_LLM=1

# ---- 可选调参 ----
# REWIND_MAX_AGENT_STEPS=30        # Agent 工具调用步数上限
# REWIND_CHECK_TIMEOUT=120         # 项目检查命令超时（秒）
# REWIND_CHECK_OUTPUT_LIMIT=4000   # 检查输出截断长度（字符）
